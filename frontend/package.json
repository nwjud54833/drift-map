{
  "name": "contract-atlas",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "driftmap": "./bin/driftmap.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --port 3000",
    "build": "node scripts/migrate-on-vercel.mjs && prisma generate && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js validate",
    "prisma:generate": "prisma generate",
    "verify:db-auth": "tsx scripts/verify-db-auth.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.104.0",
    "dexie": "^4.4.6",
    "dotenv": "^18.0.9",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.52.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "source-map-js": "^1.2.2"
  }
}
