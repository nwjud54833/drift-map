# Server-only database connection. Never expose this value to the browser.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional direct/unpooled URL for Prisma migrations. Vercel builds can also
# derive this by removing `-pooler` from the DATABASE_URL hostname.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Auth.js server secret used to protect auth state and cookies.
AUTH_SECRET="replace-with-a-long-random-server-secret"

# Google OAuth credentials from Google Cloud Console. Server-only.
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional HTTPS checkout/payment page for Pro / Team CI Cloud (Stripe,
# Razorpay, Lemon Squeezy, or another hosted checkout). Leave unset for waitlist.
# NEXT_PUBLIC_PRO_CHECKOUT_URL="https://buy.stripe.com/your-payment-link"

# Auth.js local development host trust (server-only)
AUTH_TRUST_HOST="true"

# Comma-separated Google account emails allowed to read aggregate-only
# waitlist and survey metrics at /api/v1/waitlist and
# /api/v1/admin/survey-export. No individual survey answers or emails are exported.
DRIFTMAP_ADMIN_EMAILS=

# Optional: only for real database integration tests. Use a separate, empty,
# dedicated non-production database; the suite clears data in driftmap_test.
# Never point this at production or reuse DATABASE_URL without verifying it.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require"
